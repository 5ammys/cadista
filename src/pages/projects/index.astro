---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';

function categoryClass(cat) {
  return cat.toLowerCase();
}
function dotClass(cat) {
  return 'dot--' + cat.toLowerCase();
}
---

<BaseLayout title="Galería de Proyectos | Samuel Mendez">
  <div class="projects-page">
    <!-- Sidebar / System Index -->
    <aside class="projects-page__sidebar">
      <div class="sidebar__heading">System_Index</div>
      <div class="sidebar__item active">
        <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        Projects
      </div>
      <div class="sidebar__item">
        <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        Drafting_Stds
      </div>
      
      <div class="sidebar__status">
        <div class="sidebar__status-title">System Status</div>
        <div class="sidebar__status-row">Mem_Usage: <span>42.1MB</span></div>
        <div class="sidebar__status-row">Proj_Count: <span>{projects.length} Active</span></div>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="projects-page__content">
      <div class="projects-page__topbar fade-in">
        <div>
          <div class="projects-page__ref">INDEX_REF: PRJ-2026</div>
          <h1 class="projects-page__title">Galería de Proyectos</h1>
        </div>
        
        <div class="filter-tabs">
          <button class="filter-tab active">Todos</button>
          <button class="filter-tab">Residencial</button>
          <button class="filter-tab">Comercial</button>
          <button class="filter-tab">Industrial</button>
        </div>
      </div>

      <div class="projects-grid fade-in fade-in-delay-1">
        {projects.map(p => (
          <a href={`/projects/${p.slug}`} class="project-card">
            <div class="project-card__header">
              <span class="project-card__ref mono">{p.refId} / SCALE {p.scale}</span>
            </div>
            <div class="project-card__image-wrap">
              <img src={p.image} alt={p.title} class="project-card__image" loading="lazy" />
              <div class="project-card__image-overlay"></div>
            </div>
            <div class="project-card__body">
              <div class={`project-card__category category--${categoryClass(p.category)}`}>
                <span class={`project-card__category-dot ${dotClass(p.category)}`}></span>
                {p.category}
              </div>
              <h3 class="project-card__title">{p.title}</h3>
              
              <div class="project-card__divider"></div>
              
              <div class="project-card__meta">
                <div class="project-card__meta-item">
                  <div class="project-card__meta-label">Engineering</div>
                  <div class="project-card__meta-value">{p.engineering}</div>
                </div>
                <div class="project-card__meta-item">
                  <div class="project-card__meta-label">Status</div>
                  <div class="project-card__meta-value">{p.status}</div>
                </div>
              </div>
            </div>
          </a>
        ))}
        
        <!-- Placeholder para nuevo proyecto -->
        <div class="project-card project-card--new">
          <div class="new-icon">+</div>
          <div class="new-label">Nuevo_Proyecto</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
