---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Servicios | Samuel Mendez">
  <div class="container py-section" style="padding-top: 120px; min-height: 80vh;">
    <div class="section-header fade-in">
      <div>
        <div class="section-label">Servicios</div>
        <h1 class="section-title">Soluciones de Drafting</h1>
      </div>
    </div>
    
    <div class="services-grid fade-in fade-in-delay-1">
      <div class="service-card">
        <div class="service-card__number">01</div>
        <h3 class="service-card__title">Planos Arquitectónicos 2D</h3>
        <p class="service-card__description">Desarrollo técnico de plantas, cortes y alzados para proyectos residenciales y comerciales con máximo rigor geométrico y atención al detalle normativo.</p>
        <ul class="service-card__list">
          <li>Plantas de distribución</li>
          <li>Cortes transversales y longitudinales</li>
          <li>Alzados y fachadas</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">02</div>
        <h3 class="service-card__title">Modelado 3D</h3>
        <p class="service-card__description">Levantamiento de volúmenes espaciales y piezas mecánicas a partir de planos 2D o bocetos conceptuales, optimizados para renderizado o impresión.</p>
        <ul class="service-card__list">
          <li>Modelos volumétricos en AutoCAD 3D</li>
          <li>Secciones y despieces espaciales</li>
          <li>Preparación de modelos para BIM</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">03</div>
        <h3 class="service-card__title">Digitalización Raster a Vector</h3>
        <p class="service-card__description">Conversión de planos antiguos en papel, PDF o imágenes de baja calidad a archivos CAD (DWG/DXF) totalmente editables, vectorizados y escalables.</p>
        <ul class="service-card__list">
          <li>Limpieza de geometría</li>
          <li>Estructuración estricta por capas (Layers)</li>
          <li>Asignación de cotas reales y escalas</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">04</div>
        <h3 class="service-card__title">Planos de Instalaciones</h3>
        <p class="service-card__description">Trazado y coordinación de redes de servicios para evitar colisiones y asegurar la viabilidad constructiva en proyectos multidisciplinarios.</p>
        <ul class="service-card__list">
          <li>Redes eléctricas e iluminación</li>
          <li>Saneamiento y fontanería (MEP)</li>
          <li>HVAC / Climatización</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
