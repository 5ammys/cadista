---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Servicios | Samuel Mendez">
  <div class="container py-section" style="padding-top: 120px; min-height: 80vh;">
    <div class="section-header fade-in">
      <div>
        <div class="section-label">Servicios</div>
        <h1 class="section-title">Soluciones de Drafting</h1>
      </div>
    </div>
    
    <div class="services-grid fade-in fade-in-delay-1">
      <div class="service-card">
        <div class="service-card__number">01</div>
        <h3 class="service-card__title">Planos Arquitectónicos 2D</h3>
        <p class="service-card__description">Elaboración y dibujo de planos arquitectónicos en AutoCAD para proyectos residenciales y comerciales.</p>
        <ul class="service-card__list">
          <li>Plantas de distribución</li>
          <li>Cortes y vistas</li>
          <li>Fachadas y detalles básicos</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">02</div>
        <h3 class="service-card__title">Modelado 3D</h3>
        <p class="service-card__description">Creación de modelos 3D sencillos a partir de planos 2D o bocetos utilizando herramientas de diseño asistido.</p>
        <ul class="service-card__list">
          <li>Modelado de espacios y volúmenes</li>
          <li>Modelado de piezas simples</li>
          <li>Vistas y presentaciones 3D</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">03</div>
        <h3 class="service-card__title">Digitalización de Planos</h3>
        <p class="service-card__description">Pasaje de planos en papel, PDF o imágenes a archivos CAD editables y organizados.</p>
        <ul class="service-card__list">
          <li>Redibujo de planos</li>
          <li>Organización por capas (Layers)</li>
          <li>Escalas y cotas</li>
        </ul>
      </div>
      
      <div class="service-card">
        <div class="service-card__number">04</div>
        <h3 class="service-card__title">Planos de Instalaciones</h3>
        <p class="service-card__description">Dibujo y representación básica de instalaciones sobre planos arquitectónicos.</p>
        <ul class="service-card__list">
          <li>Instalaciones eléctricas</li>
          <li>Agua y desagües</li>
          <li>Distribución básica de servicios</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
